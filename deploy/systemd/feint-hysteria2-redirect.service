[Unit]
Description=Keep Feint Hysteria2 public UDP 443 forwarded to Xray UDP 36454
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/vpn-node/scripts/cli.py udp-redirect ensure 443 36454
ExecStop=/usr/bin/python3 /opt/vpn-node/scripts/cli.py udp-redirect remove 443 36454

[Install]
WantedBy=multi-user.target
