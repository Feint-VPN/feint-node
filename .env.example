# API Settings
API_SECRET=change-me-in-production
API_PORT=8000
API_USE_SSL=true
HIDE_ENDPOINTS=true
DEV_MODE=false
SUBSCRIPTION_ENABLED=false
SUB_URI_TEMPLATE="🌌 Feint | {Protocol}"
# Empty publishes every configured protocol. Example: hysteria2,vless
PUBLISHED_PROTOCOLS=

# Server Settings
SERVER_DOMAIN=example.com
# default | vless | hysteria2
NODE_TEMPLATE=default
SERVER_IP=0.0.0.0

# SSL/TLS Settings
TLS_ENABLED=true
TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
CERTBOT_EMAIL=admin@example.com
CERTBOT_PORT=80

# VPN Protocol Ports
VLESS_PORT=443
VMESS_PORT=8443
TROJAN_PORT=2053
HYSTERIA2_PORT=2083
HYSTERIA2_COMPAT_PORT=
# Optional client-facing port when NAT forwards to HYSTERIA2_PORT.
HYSTERIA2_PUBLIC_PORT=
SHADOWSOCKS_PORT=8388
REVERSE_PROXY_PORT=39081

# Shadowsocks Settings
SHADOWSOCKS_PASSWORD=auto-generated-on-init
SHADOWSOCKS_METHOD=2022-blake3-aes-128-gcm

# VLESS REALITY Settings
REALITY_PRIVATE_KEY=generated-on-install
REALITY_PUBLIC_KEY=generated-on-install
REALITY_SHORT_ID=generated-on-install
REALITY_SERVER_NAME=google.com

# Hysteria2 Settings
HYSTERIA2_UP_MBPS=1000
HYSTERIA2_DOWN_MBPS=1000

# Runtime stats backends
CLASH_API_SECRET=auto-generated-on-install
CLASH_API_URL=http://host.docker.internal:9090
V2RAY_API_ADDRESS=host.docker.internal:10085

# Logging Settings
LOG_LEVEL=info
LOG_FORMAT=json

# Docker Settings
NODE_IMAGE=ghcr.io/feint-vpn/feint-node:latest
SINGBOX_IMAGE=ghcr.io/feint-vpn/feint-sing-box:v1.13.19-feint.2
XRAY_IMAGE=ghcr.io/feint-vpn/feint-xray:v26.7.28-feint.1
# Empty keeps Xray's security default. 1.8.1 enables older sing-box REALITY clients.
# Lowering the threshold weakens the upstream anti-probing policy; see README.
XRAY_REALITY_MIN_CLIENT_VERSION=
RATHOLE_IMAGE=ghcr.io/feint-vpn/feint-rathole:v0.5.0-feint.1
VPN_RUNTIME=sing-box
VPN_RUNTIME_IMAGE=ghcr.io/feint-vpn/feint-sing-box:v1.13.19-feint.2
VPN_RUNTIME_CONTAINER_NAME=sing-box
VPN_RUNTIME_COMMAND=run -c /opt/sing-box/config.json
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_GID=987
SINGBOX_CONTAINER_NAME=sing-box
RATHOLE_CONTAINER_NAME=feint-rathole

# Encrypted reverse transport
RATHOLE_PRIVATE_KEY=generated-on-install
RATHOLE_PUBLIC_KEY=generated-on-install
RATHOLE_CONFIG_PATH=/opt/relay/rathole.toml
RATHOLE_STATE_PATH=/opt/relay/state.json

# Config Paths
CONFIG_PATH=/opt/sing-box/config.json
XRAY_CONFIG_PATH=/opt/sing-box/xray.json
XRAY_API_LISTEN=0.0.0.0:10085
# Opt-in live HY2/VLESS additions and route assignments. With host networking,
# bind XRAY_API_LISTEN to the private Docker bridge gateway, never a public IP.
# V2RAY_API_ADDRESS must reach that same private listener from the API container.
XRAY_HOT_RELOAD=false
# Optional sing-box TUIC companion for Xray (enable Compose profile `tuic`).
# Configure a tuic-in inbound and bind stats to a PRIVATE host bridge address.
TUIC_CONTAINER_NAME=
TUIC_CONFIG_PATH=/opt/sing-box/tuic.json
TUIC_STATS_LISTEN=127.0.0.1:10086
TUIC_STATS_ADDRESS=
TUIC_IMAGE=ghcr.io/feint-vpn/feint-sing-box:v1.13.19-feint.2
BACKUP_DIR=/opt/sing-box/backups
